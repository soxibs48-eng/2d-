; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be edited by hand.

config_version=5

[application]

config/name="Pixel Runner"
config/description="Pixel Runner (Antigravitatsiya mexanikasi bilan) - 2D Endless Runner Capstone Project"
config/version="2.0.0"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
boot_splash/bg_color=Color(0.0470588, 0.0627451, 0.109804, 1)
config/icon="res://assets/sprites/pickups/powerup_gravity.png"

[autoload]

GameData="*res://scripts/data/game_data.gd"
SaveSystem="*res://scripts/systems/save_system.gd"
SoundManager="*res://scripts/managers/sound_manager.gd"
SceneManager="*res://scripts/managers/scene_manager.gd"
GameManager="*res://scripts/managers/game_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=0
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

